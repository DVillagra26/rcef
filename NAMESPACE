# HAND-WRITTEN. Deliberately NOT generated by roxygen2.
#
# The first line of a roxygen-generated NAMESPACE says so, and roxygen2
# only overwrites files carrying that marker. This one does not carry it,
# so devtools::document() will REFUSE to touch this file and error out
# instead. That refusal is the point.
#
# Why: 222 functions are defined under R/, but only ~114 currently carry
# an @export tag - and the gaps are load-bearing. catchRaising(),
# catchAllocationAoL(), every function in rcef_alloc.R, and 32 of the 33
# in rcef_length.R have none. Running document() today would generate a
# NAMESPACE that hides all of them, and the app would die on the first
# call with "could not find function".
#
# Until every intended export is tagged (see dev/check_exports.R), this
# blanket pattern is the correct NAMESPACE: it exports everything that
# does not start with a dot, which is exactly what the source()-based app
# used to see.
#
# To move to generated exports: tag the missing functions, run
#   Rscript dev/check_exports.R
# to confirm nothing is lost, THEN delete this file and document().

exportPattern("^[^.]")

import(dplyr)
import(ggplot2)
import(rlang)
importFrom(data.table, setDT)
importFrom(data.table, rbindlist)
importFrom(data.table, dcast)
importFrom(tidyr, pivot_longer)
importFrom(tidyr, pivot_wider)
